*.m3u8_cache/
*lista_rtv30t_wintvx.m3u
ECOSSISTEMA_STREAMING_IPTV/saida/lista_rtv30t_wintvx.m3u
*.ts

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ambientes Virtuais
venv/
.venv/
ENV/

# Logs e Processos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores e Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Backups temporários
*.bak
*.tmp

# Projeto independente da Central de Rádios Pro
CENTRAL_RADIOS_PRO/
VITRINE_JONAS_SITE/


# Arquivos de geracao temporaria de avatar/audio
AUDIO_JONAS_OFICIAL.*
MEU_AUDIO_JONAS.*
MEU_AVATAR_JONAS.*
face_crop.png
jonas_mouth_open*
yt_check/

# Listas VIP Privadas e Chaves de Assinantes (NUNCA sobem para o GitHub público)
.env
.env.*
!.env.example
ECOSSISTEMA_STREAMING_IPTV/vip_privado/*.m3u
ECOSSISTEMA_STREAMING_IPTV/vip_privado/*.m3u8
ECOSSISTEMA_STREAMING_IPTV/vip_privado/*.json
